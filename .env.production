NODE_ENV=production
PORT=3000

APP_URL=http://localhost:3000

DATABASE_HOST=postgres
DATABASE_NAME=expense_api_prod
DATABASE_USER=expense_api
DATABASE_PORT=5432
DATABASE_PASSWORD_FILE=./secrets/database_password.txt
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT=5000
DATABASE_IDLE_TIMEOUT=30000
DATABASE_MAX_LIFETIME=1800
DATABASE_SSL=true

REDIS_HOST=redis
REDIS_USERNAME=default
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD_FILE=./secrets/redis_password.txt

JWT_SECRET_FILE=./secrets/jwt_secret.txt

THROTTLE_TTL=60000
THROTTLE_LIMIT=60

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME_FILE=./secrets/mail_username.txt
MAIL_PASSWORD_FILE=./secrets/mail_password.txt
MAIL_SECURE=false
MAIL_FROM=expense-api@noreply.com
MAIL_TLS_REJECT_UNAUTHORIZED=true
MAIL_CONNECTION_TIMEOUT=10000
MAIL_GREETING_TIMEOUT=10000

GOOGLE_OAUTH_CLIENT_ID_FILE=./secrets/google_oauth_client_id.txt
GOOGLE_OAUTH_CLIENT_SECRET_FILE=./secrets/google_oauth_client_secret.txt
GOOGLE_OAUTH_CALLBACK_URL=/v1/api/authentication/google/callback
