FROM postgres:16

ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates && \
    curl -L https://github.com/wal-g/wal-g/releases/download/v3.0.9/wal-g-pg-22.04-aarch64.tar.gz | tar -xz && \
    mv wal-g-pg-22.04-aarch64 /usr/local/bin/wal-g && \
    chmod 755 /usr/local/bin/wal-g && \
    curl -fsSL https://github.com/aptible/supercronic/releases/latest/download/supercronic-linux-${TARGETARCH} -o /usr/local/bin/supercronic && \
    chmod 755 /usr/local/bin/supercronic

COPY dbBackup.cron /etc/dbBackup.cron
COPY ./scripts/database/backup-push.sh /usr/local/bin/backup-push.sh
COPY ./scripts/database/docker-entrypoint-backup.sh /usr/local/bin/docker-entrypoint-backup.sh

RUN chmod +x /usr/local/bin/backup-push.sh && \
    chmod +x /usr/local/bin/docker-entrypoint-backup.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint-backup.sh"]

CMD ["supercronic", "/etc/dbBackup.cron"]
