        "ioredis": "6.0.0-beta.1",
        "kafkajs": "^2.2.4",
        "nestjs-cls": "^6.2.1",
        "nestjs-pino": "^4.6.0",
        "nodemailer": "^10.0.5",
        "p-limit": "^7.3.1",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.18.0",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "request-ip": "^3.3.0",
        "rxjs": "^7.8.1",
        "uuid": "^14.0.2"
