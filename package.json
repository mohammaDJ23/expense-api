            "engine.io": ">=6.6.10",
            "source-map-js": ">=1.2.2",
            "postcss-selector-parser": ">=7.1.6",
            "follow-redirects": ">=1.16.1",
            "body-parser": ">=2.4.0"
        }
    },
    "scripts": {
        "prepare": "husky",
        "build": "nest build",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "lint:fix": "eslint . --fix",
        "lint:ci": "eslint . --max-warnings=0",
        "format:ci": "prettier --check .",
        "eslint:security:scan": "pnpm exec eslint . --ext js,ts --plugin security --config eslint.config.mjs",
        "ts:compilation:security:scan": "tsc --project tsconfig.security.json",
        "ts:tsec:security:scan": "tsec --project tsconfig.security.json",
        "start": "nest start",
        "start:dev": "env-cmd -f .env nest start --watch",
        "start:debug": "nest start --debug=0.0.0.0:9229 --watch",
        "start:prod": "node dist/main",
        "semantic-release": "semantic-release",
        "prepare:release": "prettier --write CHANGELOG.md package.json",
        "install:ci": "pnpm install --ignore-scripts --frozen-lockfile",
        "name:app:docker:image": "bash ./scripts/app/docker-image-name.sh",
        "push:app:docker:image": "bash ./scripts/app/docker-image-push.sh",
        "tag:app:docker:image": "bash ./scripts/app/docker-image-tag.sh",
        "start:docker:development": "bash ./scripts/app/docker-entrypoint-development.sh",
        "start:docker:ci": "bash ./scripts/app/docker-entrypoint-ci.sh",
        "start:docker:production": "bash ./scripts/app/docker-entrypoint-production.sh",
        "name:migration:database:docker:image": "bash ./scripts/database/docker-migration-image-name.sh",
        "build:migration:database:docker:image": "bash ./scripts/database/docker-migration-image-build.sh",
        "push:migration:database:docker:image": "bash ./scripts/database/docker-migration-image-push.sh",
        "tag:migration:database:docker:image": "bash ./scripts/database/docker-migration-image-tag.sh",
        "db:restore": "bash ./scripts/database/local-entrypoint-restore.sh",
        "db:replace": "bash ./scripts/database/local-entrypoint-replace.sh",
        "create:branch:id": "bash ./scripts/branch-id-creation.sh",
        "validate:branch:name:development": "bash ./scripts/branch-name-validator-development.sh",
        "validate:commit:message": "bash ./scripts/commit-message-validator.sh",
        "lint:staged": "bash ./scripts/lint-staged.sh",
        "create:version": "bash ./scripts/version-creation.sh",
        "detect:branch:name": "bash ./scripts/branch-name-detect.sh",
        "validate:branch:name:ci": "bash ./scripts/branch-name-validator-ci.sh",
        "detect:commitsha": "bash ./scripts/commit-sha-detect.sh",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push --force",
        "knip": "knip"
    },
    "dependencies": {
        "@elastic/elasticsearch": "^8.17.0",
        "@humanwhocodes/env": "^4.0.1",
        "@liaoliaots/nestjs-redis": "^10.0.0",
