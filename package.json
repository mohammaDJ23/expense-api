            "path-to-regexp": ">=8.4.0",
            "socket.io-parser": ">=4.2.6",
            "protobufjs": ">=7.5.5",
            "lodash-es": ">=4.18.0",
            "lodash": ">=4.18.0",
            "fast-uri": ">=4.1.3",
            "esbuild": ">=0.28.1",
            "tmp": ">=0.2.7",
            "ws": ">=8.21.0",
            "form-data": ">=4.0.6",
            "piscina": ">=5.3.2",
